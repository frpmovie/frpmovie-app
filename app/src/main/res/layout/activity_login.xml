<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/logo"
            android:layout_marginBottom="16dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reproductor IPTV: conecta tu propio servicio"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="@drawable/chip_bg"
            android:maxWidth="400dp"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnModeXtream"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:minHeight="0dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Xtream Codes"
                android:textSize="13sp"
                android:textColor="@color/ink"
                android:background="@drawable/tab_pill_bg"
                android:backgroundTint="@color/brand" />

            <Button
                android:id="@+id/btnModeM3u"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:minHeight="0dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Lista M3U"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:background="@drawable/tab_pill_bg" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupXtream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:maxWidth="400dp">

            <EditText
                android:id="@+id/etServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Servidor (http://tuservidor.com:puerto)"
                android:textColorHint="@color/muted"
                android:textColor="@color/ink"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:layout_marginBottom="14dp"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/etUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Usuario"
                android:textColorHint="@color/muted"
                android:textColor="@color/ink"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:layout_marginBottom="14dp"
                android:inputType="text" />

            <EditText
                android:id="@+id/etPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contraseña"
                android:textColorHint="@color/muted"
                android:textColor="@color/ink"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:layout_marginBottom="10dp"
                android:inputType="textPassword" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupM3u"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:maxWidth="400dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/etM3uUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="URL de la lista M3U/M3U8"
                android:textColorHint="@color/muted"
                android:textColor="@color/ink"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:layout_marginBottom="10dp"
                android:inputType="textUri" />

        </LinearLayout>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Entrar"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:background="@drawable/btn_bg"
            android:padding="14dp"
            android:layout_marginTop="14dp"
            android:maxWidth="400dp" />

    </LinearLayout>
</ScrollView>
